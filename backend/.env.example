# Copie este arquivo para .env e ajuste se necessário:  cp .env.example .env
# Nunca versione o .env (RNF05: segredos só em variáveis de ambiente).

AMBIENTE=desenvolvimento
DATABASE_URL=postgresql+psycopg://confirma:confirma@localhost:5432/confirma_ai

# Gere uma chave nova com:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRA_MINUTOS=60

FRONTEND_URL=http://localhost:3000
FUSO_HORARIO=America/Cuiaba

# Mensageria: "simulador" (desenvolvimento) ou "whatsapp" (Cloud API)
MENSAGERIA_PROVEDOR=simulador
WEBHOOK_SEGREDO=segredo-webhook-dev

# Tarefas automáticas (lembretes, envio, expiração de ofertas, retenção)
AGENDADOR_ATIVO=true
OUTBOX_INTERVALO_SEG=10
TAREFAS_INTERVALO_SEG=60

# Usuário administrador criado por "python -m app.seed"
ADMIN_LOGIN=admin
ADMIN_SENHA=Admin@123

# Somente quando MENSAGERIA_PROVEDOR=whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LEMBRETE=
WHATSAPP_TEMPLATE_OFERTA=
